# 楽天ウェブサービス「アプリ情報の確認」ページで取得した値を設定してください
RAKUTEN_APPLICATION_ID=your_application_id_here
RAKUTEN_ACCESS_KEY=your_access_key_here
RAKUTEN_AFFILIATE_ID=your_affiliate_id_here

# 楽天ウェブサービスの「許可されたWebサイト」欄に登録した本番ドメイン。
# 未設定の場合は https://www.dokoiku.tokyo が使われます(lib/rakuten.ts参照)。
# ローカル開発時にAPIが403になる場合は、開発用ドメイン(または登録済みドメイン)を設定してください。
RAKUTEN_ORIGIN=https://www.dokoiku.tokyo

# SEOメタデータ・サイトマップ生成に使用する本番URL
NEXT_PUBLIC_SITE_URL=https://www.dokoiku.tokyo
